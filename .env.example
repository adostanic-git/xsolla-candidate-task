# Bearer token required on every /v1/* request (Authorization: Bearer <token>)
AUTH_TOKEN=change-me

# Port the HTTP server listens on
PORT=3000

# --- llm provider (optional) ---
# If unset, the "llm" provider fails gracefully (job status "failed") instead of crashing.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-3-5-haiku-20241022
LLM_TIMEOUT_MS=20000
